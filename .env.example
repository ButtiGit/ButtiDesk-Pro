APP_NAME=ButtiDesk-Pro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
# SQLite defaults to database/database.sqlite; Docker overrides these values.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=buttidesk_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Local-only demo. Access is ALWAYS refused outside local/testing environments.
DESK_DEMO_ENABLED=true
DESK_TIMEZONE=Europe/Rome
VITE_APP_NAME=ButtiDesk-Pro
